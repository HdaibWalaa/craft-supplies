DATABASE_URL="file:./dev.db"

# Auth.js — generate a real secret for production with: npx auth secret
AUTH_SECRET="dev-only-insecure-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# Stripe — leave blank to use the built-in simulated checkout flow.
# Fill in with test-mode keys from https://dashboard.stripe.com/test/apikeys to enable real Stripe Checkout.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Analytics — leave blank to disable.
NEXT_PUBLIC_GA_ID=""

# Store contact info
NEXT_PUBLIC_WHATSAPP_NUMBER="15551234567"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
